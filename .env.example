# BTP Starter Pack — Environment Variables
# Copy this file to .env and fill in the values
# NEVER commit .env to git

# Optional: Override log level (debug | info | warn | error)
LOG_LEVEL=info

# Optional: Override log file path
# LOG_FILE=./logs/btp-starter-pack.log

# Optional: Disable colored output (useful for CI)
# NO_COLOR=true

# Optional: Skip confirmations (use with extreme caution, only for automated testing)
# BTP_STARTER_SKIP_CONFIRM=false

# NOTE: No passwords, tokens or credentials are stored here.
# SAP BTP CLI and CF CLI manage their own sessions via browser-based OIDC flow.
