{
  "name": "btp-starter-pack",
  "version": "1.1.0",
  "description": "CLI tool to prepare a SAP BTP Trial account for development in Business Application Studio",
  "main": "dist/index.js",
  "bin": {
    "btp-starter-pack": "./dist/index.js"
  },
  "files": [
    "dist",
    "dist-ui",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "build:ui": "cd ui && npm install && npm run build",
    "build:all": "npm run build && npm run build:ui",
    "start": "node dist/index.js",
    "start:ui": "node dist/index.js ui",
    "dev": "ts-node src/index.ts",
    "test": "npm run build && node tests/run-all.js",
    "test:vitest": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "clean": "rimraf dist dist-ui",
    "prebuild": "rimraf dist"
  },
  "keywords": [
    "sap",
    "btp",
    "cloud-foundry",
    "business-application-studio",
    "cli",
    "starter-pack",
    "cap",
    "sapui5"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/js-yaml": "^4.0.9",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "execa": "^5.1.1",
    "express": "^4.19.2",
    "fs-extra": "^11.2.0",
    "inquirer": "^8.2.6",
    "js-yaml": "^4.1.1",
    "open": "^8.4.2",
    "ora": "^5.4.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
